# Example variable names only. Contains no credentials. Never commit real values.
# Local development: copy to .env.local.

APP_ORIGIN=http://localhost:3000
# Generate with: npx auth secret
AUTH_SECRET=
# Google Cloud Console → OAuth client ID (Web). Redirect URI: <APP_ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-verified Workspace domain (exact hd match).
# Organizers are listed in code (src/config/competition.ts → ORGANIZER_EMAILS), not in env.
ALLOWED_GOOGLE_DOMAIN=zemingo.com

# Postgres. DATABASE_URL = runtime — on Vercel use Supabase's "Transaction pooler" (port 6543);
# DIRECT_URL = migrations — Supabase "Session pooler" (port 5432).
# If DATABASE_URL is empty in development, an embedded PGlite database in .data/pglite is used.
DATABASE_URL=
DIRECT_URL=
# Apply migrations on first connection (otherwise run: npm run db:migrate)
DATABASE_AUTO_MIGRATE=false

# Release 2: private media. Currently cover images are stored privately in Postgres
# and served only through the permission-checked /api/media route; these are reserved
# for moving covers to object storage. Server key never belongs in NEXT_PUBLIC_* variables.
SUPABASE_URL=
STORAGE_SERVER_KEY=
STORAGE_BUCKET=halloween-covers

# ── Development only (ignored when NODE_ENV=production) ──
# Local sign-in form for rehearsal without Google. Not a substitute for real Google sign-in.
DEV_LOGIN_ENABLED=false
# Pretend the server clock is at a given instant:
# DEV_FAKE_NOW=2026-10-26T10:00:00+02:00

# Business dates and approved rules are seeded into the database (src/config/competition.ts).
# No OpenAI key or runtime AI service is required.
